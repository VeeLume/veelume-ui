{
  "name": "@veelume/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Opinionated, uncoupled Svelte UI kit — cache primitives, surfaces, shells",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "svelte": "^5",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "bits-ui": "^2.16.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  }
}
